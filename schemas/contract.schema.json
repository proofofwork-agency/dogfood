{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofofwork.agency/schemas/dogfood-contract-v2.json",
  "title": "Dogfood contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project",
    "commands",
    "gates",
    "oracles",
    "acceptanceCriteria"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireIdentity"],
      "properties": {
        "requireIdentity": {
          "type": "boolean"
        },
        "identityCommand": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "algorithm"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "algorithm": {
              "type": "string",
              "const": "sha256"
            }
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/command"
      }
    },
    "gates": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "oracles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/oracle"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "timeoutMs", "adapter"],
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "adapter": {
          "type": "string",
          "enum": ["exit-code", "playwright-json"]
        }
      }
    },
    "oracle": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command"],
          "properties": {
            "kind": {
              "const": "command"
            },
            "command": {
              "$ref": "#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command", "tag"],
          "properties": {
            "kind": {
              "const": "playwright"
            },
            "command": {
              "$ref": "#/$defs/name"
            },
            "tag": {
              "type": "string",
              "pattern": "^@dogfood:[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "advisory"
            }
          }
        }
      ]
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "severity"],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "enum": ["deterministic", "judgmental", "excluded"]
        },
        "oracle": {
          "$ref": "#/$defs/name"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["blocker", "major", "minor"],
          "description": "Classification metadata. All deterministic criteria block regardless of severity in v2."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "enum": ["deterministic", "judgmental"]
              }
            },
            "required": ["class"]
          },
          "then": {
            "required": ["oracle"],
            "properties": {
              "oracle": {
                "$ref": "#/$defs/name"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "excluded"
              }
            },
            "required": ["class"]
          },
          "then": {
            "required": ["reason"],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
