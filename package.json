{
  "name": "@proofofwork-agency/dogfood",
  "version": "0.3.0",
  "description": "Portable evidence gate with exact command and Playwright acceptance proof.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proofofwork-agency/dogfood.git"
  },
  "bugs": {
    "url": "https://github.com/proofofwork-agency/dogfood/issues"
  },
  "homepage": "https://github.com/proofofwork-agency/dogfood#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dogfood": "bin/dogfood.mjs",
    "pow-dogfood": "bin/dogfood.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "schemas/",
    "templates/",
    "docs/",
    "examples/minimal/.dogfood/",
    "examples/minimal/checks/",
    "examples/minimal-broken/.dogfood/",
    "examples/playwright/.dogfood/",
    "examples/playwright/checks/",
    "examples/playwright/tests/",
    "examples/playwright/page.html",
    "examples/playwright/playwright.config.mjs",
    "examples/playwright/server.mjs",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dogfood": "node bin/dogfood.mjs",
    "test": "node --test test/adapters.test.mjs test/baseline.test.mjs test/cli.test.mjs test/contract.test.mjs test/docs.test.mjs test/files.test.mjs test/integration.test.mjs test/meta.test.mjs test/package-contents.test.mjs test/policy.test.mjs test/report.test.mjs test/runtime.test.mjs test/sign.test.mjs test/verify.test.mjs test/workflow.test.mjs",
    "test:playwright-fixture": "node test/playwright-fixture.mjs",
    "test:self": "cd examples/minimal && node ../../bin/dogfood.mjs run"
  },
  "keywords": [
    "dogfood",
    "e2e",
    "evidence",
    "playwright",
    "acceptance",
    "ci"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
